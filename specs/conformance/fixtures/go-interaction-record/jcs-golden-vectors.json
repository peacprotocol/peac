      "description": "Unicode key ordering (non-ASCII keys sorted by UTF-16 code unit, RFC 8785 3.2.3)",
      "input": {
        "é": 1,
        "a": 2,
        "À": 3,
        "z": 4
      },
      "canonical": "{\"a\":2,\"z\":4,\"À\":3,\"é\":1}"
