{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peacprotocol.org/specs/conformance/parity-corpus/ed25519-peac-profile/runtime-observations.schema.json",
  "title": "Ed25519 profile runtime observations",
  "description": "Informative record of measured Ed25519 primitive decisions per implementation version. No conformance decision reads this file; peac_expected in vectors.json is normative.",
  "type": "object",
  "required": ["family", "status", "observed_on", "environments", "observations"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "./runtime-observations.schema.json"
    },
    "family": {
      "const": "ed25519-peac-profile"
    },
    "status": {
      "const": "Informative"
    },
    "description": {
      "type": "string"
    },
    "observed_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._:@/-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "implementation",
          "version",
          "platform",
          "os_release",
          "harness",
          "harness_sha256",
          "corpus_sha256",
          "lockfile_sha256"
        ],
        "properties": {
          "implementation": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "pattern": "^[a-z0-9]+/[a-z0-9]+$"
          },
          "os_release": {
            "type": "string",
            "minLength": 1
          },
          "harness_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "runtime": {
            "type": "string",
            "minLength": 1
          },
          "runtime_version": {
            "type": "string",
            "minLength": 1
          },
          "v8": {
            "type": "string",
            "minLength": 1
          },
          "openssl": {
            "type": "string",
            "minLength": 1
          },
          "engine": {
            "type": "string",
            "minLength": 1
          },
          "surface": {
            "enum": ["raw-primitive", "peac-wrapper"]
          },
          "secure_context_origin": {
            "type": "string",
            "minLength": 1
          },
          "harness": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+$"
          },
          "bundler_version": {
            "type": "string",
            "minLength": 1
          },
          "corpus_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "lockfile_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "measured_artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "wrapper_bundle_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "production_source_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": ["runtime"]
            },
            "then": {
              "required": ["runtime_version"]
            }
          },
          {
            "if": {
              "properties": {
                "runtime": {
                  "const": "node"
                }
              },
              "required": ["runtime"]
            },
            "then": {
              "required": ["v8", "openssl"]
            }
          },
          {
            "if": {
              "required": ["engine"]
            },
            "then": {
              "required": ["surface", "secure_context_origin", "runtime_version", "bundler_version"]
            }
          },
          {
            "if": {
              "properties": {
                "surface": {
                  "const": "peac-wrapper"
                }
              },
              "required": ["surface"]
            },
            "then": {
              "required": [
                "measured_artifact_sha256",
                "wrapper_bundle_sha256",
                "production_source_manifest_sha256"
              ]
            }
          }
        ]
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["vector_id", "environment_id", "outcome"],
        "additionalProperties": false,
        "properties": {
          "vector_id": {
            "type": "string",
            "minLength": 1
          },
          "environment_id": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": ["accept", "reject", "unsupported"]
          }
        }
      }
    },
    "measurement_source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
