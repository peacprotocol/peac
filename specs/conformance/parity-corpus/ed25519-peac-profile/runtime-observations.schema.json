{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peacprotocol.org/specs/conformance/parity-corpus/ed25519-peac-profile/runtime-observations.schema.json",
  "title": "Ed25519 profile runtime observations",
  "description": "Informative record of measured Ed25519 primitive decisions per implementation version. No conformance decision reads this file; peac_expected in vectors.json is normative.",
  "type": "object",
  "required": ["family", "status", "observed_on", "environments", "observations"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "family": {
      "const": "ed25519-peac-profile"
    },
    "status": {
      "const": "Informative"
    },
    "description": {
      "type": "string"
    },
    "observed_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._:@/-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["implementation", "version", "platform", "harness", "harness_sha256"],
        "properties": {
          "implementation": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "pattern": "^[a-z0-9]+/[a-z0-9]+$"
          },
          "os_release": {
            "type": "string",
            "minLength": 1
          },
          "harness_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "runtime": {
            "type": "string"
          },
          "runtime_version": {
            "type": "string"
          },
          "v8": {
            "type": "string"
          },
          "openssl": {
            "type": "string"
          },
          "engine": {
            "type": "string"
          },
          "surface": {
            "enum": ["raw-primitive", "peac-wrapper"]
          },
          "secure_context_origin": {
            "type": "string"
          },
          "harness": {
            "type": "string",
            "minLength": 1
          },
          "bundler_version": {
            "type": "string"
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["vector_id", "environment_id", "outcome"],
        "additionalProperties": false,
        "properties": {
          "vector_id": {
            "type": "string",
            "minLength": 1
          },
          "environment_id": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": ["accept", "reject", "unsupported"]
          }
        }
      }
    }
  }
}
