{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peacprotocol.org/security/audit-exception/1",
  "title": "Audit exception record",
  "description": "A time-bounded, owned, path-scoped exception. Wildcards and advisory-only entries are rejected: an exception must state exactly what it excuses and when it stops applying.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "advisory",
    "package",
    "affectedPaths",
    "reachability",
    "reason",
    "owner",
    "expiresOn",
    "remediationIssue",
    "fixedVersionOrMigration"
  ],
  "properties": {
    "advisory": { "type": "string", "pattern": "^(GHSA-[a-z0-9-]+|CVE-[0-9]{4}-[0-9]+)$" },
    "package": { "type": "string", "minLength": 1, "not": { "pattern": "[*?]" } },
    "affectedPaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "not": { "pattern": "[*?]" } }
    },
    "reachability": {
      "enum": ["production-reachable", "build-only", "test-only", "example-only", "not-reachable"]
    },
    "reason": { "type": "string", "minLength": 20 },
    "owner": { "type": "string", "minLength": 1 },
    "expiresOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "remediationIssue": { "type": "string", "minLength": 1 },
    "fixedVersionOrMigration": { "type": "string", "minLength": 1 }
  }
}
