{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "format:check": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "build:types": {
      "dependsOn": ["^build:types"],
      "outputs": ["dist/**/*.d.ts", "dist/**/*.d.ts.map", "dist/.tsbuildinfo"]
    },
    "typecheck": {
      "dependsOn": ["^build:types"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", "lib/**", "*.tsbuildinfo"]
    },
    "@peac/app-verifier#build": {
      "dependsOn": ["^build"],
      "env": ["PEAC_VERIFIER_BUILD", "PEAC_VERIFIER_REQUIRE_CLEAN"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "conformance": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "perf": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "bench": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
