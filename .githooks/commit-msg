#!/usr/bin/env bash
# .githooks/commit-msg
# Repo-managed commit-msg hook: fails closed when the commit message file cannot be read.
# Install: bash scripts/setup-hooks.sh (or: git config core.hooksPath .githooks)
#
# Git passes the message file as $1. Without an argument the path is resolved with
# `git rev-parse --git-path COMMIT_EDITMSG`, which is also correct inside a linked worktree.
#
# Bypass: PEAC_SKIP_COMMIT_MSG=1 git commit -m "..."

set -euo pipefail

COMMIT_MSG_FILE="${1:-$(git rev-parse --git-path COMMIT_EDITMSG 2>/dev/null || true)}"

if [ "${PEAC_SKIP_COMMIT_MSG:-}" = "1" ]; then
  echo "[commit-msg] BYPASSED (PEAC_SKIP_COMMIT_MSG=1)"
  echo "[commit-msg] WARNING: Commit message was not checked."
  exit 0
fi

if [ ! -f "$COMMIT_MSG_FILE" ] || [ ! -r "$COMMIT_MSG_FILE" ]; then
  echo "[commit-msg] FAIL: rule message-file-unreadable"
  exit 1
fi

echo "[commit-msg] OK"
