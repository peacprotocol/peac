#!/usr/bin/env bash
# .githooks/commit-msg
# Repo-managed commit-msg hook: checks the commit message against built-in rules.
# Install: bash scripts/setup-hooks.sh (or: git config core.hooksPath .githooks)
#
# Built-in rules only. No pattern file is read from any path, and a finding is reported
# as a rule id, never as the pattern or the offending text.
#
# Git passes the message file as $1. When the hook is run by hand without an argument, the
# message path is resolved with `git rev-parse --git-path COMMIT_EDITMSG`, which is also
# correct inside a linked worktree.
#
# Bypass: PEAC_SKIP_COMMIT_MSG=1 git commit -m "..."

set -euo pipefail

COMMIT_MSG_FILE="${1:-$(git rev-parse --git-path COMMIT_EDITMSG)}"

if [ "${PEAC_SKIP_COMMIT_MSG:-}" = "1" ]; then
  echo "[commit-msg] BYPASSED (PEAC_SKIP_COMMIT_MSG=1)"
  echo "[commit-msg] WARNING: Commit message was not checked for non-technical language."
  exit 0
fi

FAILED=0

# Built-in checks (always active, safe for tracked script)
if grep -iE 'reference/.*_LOCAL\.' "$COMMIT_MSG_FILE" >/dev/null 2>&1; then
  echo "[commit-msg] FAIL: rule local-reference-path in $COMMIT_MSG_FILE"
  FAILED=1
fi

if grep -iE '(NEXT_STEPS|ROADMAP_LOCAL|STRATEGY_LOCAL|SCOPE_LEDGER|MASTER_PLAN_LOCAL)' "$COMMIT_MSG_FILE" >/dev/null 2>&1; then
  echo "[commit-msg] FAIL: rule planning-marker in $COMMIT_MSG_FILE"
  FAILED=1
fi

if [ "$FAILED" -eq 1 ]; then
  echo ""
  echo "[commit-msg] Commit message contains non-technical language."
  echo "[commit-msg] Rewrite the message to be technical and implementation-focused."
  echo "[commit-msg] Bypass: PEAC_SKIP_COMMIT_MSG=1 git commit ..."
  exit 1
fi

echo "[commit-msg] OK"
